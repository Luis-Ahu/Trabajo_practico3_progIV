@token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjEsImlhdCI6MTc5NDc4ODY4NiwiZXhwIjoxNzk0ODAzMDg2fQ.D5rWa3-76s6AUj6IEz4IpbJPgaau2OfhuirtMLEeqWM

### Listar vehículos
GET {{url}}/vehiculos
Authorization: Bearer {{token}}

### Listar sin token (debe dar 401)
GET {{url}}/vehiculos

### Obtener vehículo por ID
GET {{url}}/vehiculos/1
Authorization: Bearer {{token}}

### Obtener vehículo inexistente (debe dar 404)
GET {{url}}/vehiculos/9999
Authorization: Bearer {{token}}

### Obtener con ID inválido (debe dar 400)
GET {{url}}/vehiculos/abc
Authorization: Bearer {{token}}

### Crear vehículo
POST {{url}}/vehiculos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "marca": "Mercedes",
  "modelo": "Actros",
  "patente": "AB123CD",
  "año": 2020,
  "capacidad_carga_kg": 18000
}

### Crear con datos inválidos (debe dar 400)
POST {{url}}/vehiculos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "marca": "",
  "modelo": "Actros",
  "patente": "AB",
  "año": 1800,
  "capacidad_carga_kg": -5
}

### Crear con patente repetida (debe dar 400)
POST {{url}}/vehiculos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "marca": "Mercedes",
  "modelo": "Actros",
  "patente": "AB123CD",
  "año": 2020,
  "capacidad_carga_kg": 18000
}

### Modificar vehículo
PUT {{url}}/vehiculos/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "marca": "Mercedes",
  "modelo": "Actros 2651",
  "patente": "AB123CD",
  "año": 2021,
  "capacidad_carga_kg": 20000
}

### Modificar vehículo inexistente (debe dar 404)
PUT {{url}}/vehiculos/9999
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "marca": "Mercedes",
  "modelo": "Actros",
  "patente": "ZZ999ZZ",
  "año": 2021,
  "capacidad_carga_kg": 20000
}

### Eliminar vehículo
DELETE {{url}}/vehiculos/1
Authorization: Bearer {{token}}

### Eliminar vehículo inexistente (debe dar 404)
DELETE {{url}}/vehiculos/9999
Authorization: Bearer {{token}}